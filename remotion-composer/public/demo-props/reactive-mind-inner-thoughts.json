      "mediaDuration": 14.0,
      "mediaStart": 0,
      "title": "NHẬT KÝ TÂM LÝ · 02:07 AM",
      "text": "Khi con người mắc kẹt trong trạng thái sinh tồn\nvà hành xử hoàn toàn theo bản năng.",
      "lines": [
        "Một câu chuyện về những phản xạ vô thức làm tổn thương người gần mình nhất."
      ]
    },
    {
      "id": "beat-02",
      "start": 4.1,
      "end": 10.1,
      "chapterId": 1,
      "kind": "note",
      "media": "episodes/reactive-mind/loai1_02_phone_dark.mp4",
      "mediaDuration": 14.0,
      "mediaStart": 0,
      "title": "GHI CHÚ ĐÊM KHUYA · BA PHẢN XẠ TỰ ĐỘNG",
      "noteLabels": [
        "01 · Khi tức giận",
        "02 · Khi sợ hãi",
        "03 · Khi buồn bã"
      ],
      "lines": [
        "Lập tức công kích để tự vệ và lấn át đối phương.",
        "Tìm cách thu mình, khép kín và trốn tránh thực tại.",
        "Quay sang đổ lỗi cho hoàn cảnh hoặc người xung quanh."
      ]
    },
    {
      "id": "beat-03",
      "start": 10.1,
      "end": 13.5,
      "chapterId": 1,
      "kind": "question",
      "media": "episodes/reactive-mind/loai1_03_lonely_walk.mp4",
      "mediaDuration": 14.0,
      "mediaStart": 0,
      "title": "KHOẢNG LẶNG BỊ BỎ QUÊN",
      "text": "“Tại sao mình lại cảm thấy như vậy?”",
      "lines": [
        "Hầu hết chúng ta phản ứng ngay lập tức mà hiếm khi dừng lại một nhịp để tự hỏi chính mình."
      ]
    },
    {
      "id": "beat-04",
      "start": 13.5,
      "end": 18.0,
      "chapterId": 1,
      "kind": "footage",
      "media": "episodes/reactive-mind/loai1_04_coffee_window.mp4",
      "mediaDuration": 14.0,
      "mediaStart": 0,
      "title": "Phản ứng tức khắc chỉ khiến ta vô tình trút những tổn thương bên trong lên người xung quanh",
      "sourceCredit": "Cảnh đời thường ban đêm · Pixabay HD"
    },
    {
      "id": "beat-05",
      "start": 18.0,
      "end": 24.7,
      "chapterId": 2,
      "kind": "phone",
      "media": "episodes/reactive-mind/loai1_05_hands_thinking.mp4",
      "mediaDuration": 14.0,
      "mediaStart": 0,
      "title": "Khi cái tôi bị chạm tới,\ncơ chế phòng thủ bật lên ngay.",
      "left": "Anh/em góp ý thật lòng nhé, cách xử lý vừa rồi hơi vội vàng đấy.",
      "text": "Tôi làm vậy là có lý do cả, bạn không ở trong hoàn cảnh của tôi thì đừng phán xét!"
    },
    {
      "id": "beat-06",
      "start": 24.7,
      "end": 32.1,
      "chapterId": 2,
      "kind": "comparison",
      "media": "episodes/reactive-mind/loai1_06_rain_street.mp4",
      "mediaDuration": 14.0,
      "mediaStart": 0,
      "title": "HAI LỰA CHỌN TRƯỚC MỘT SỰ THẬT KHÓ NGHE",
      "leftLabel": "Khi cái tôi bật chế độ phòng thủ",
      "left": "“Bảo vệ quan điểm tới cùng, chọn cảm giác được công nhận và dễ chịu nhất thời.”",
      "rightLabel": "Khi đủ dũng khí trưởng thành",
      "right": "“Dám đối diện với sự thật, lắng nghe để thấu hiểu và chấp nhận thay đổi.”"
    },
    {
      "id": "beat-07",
      "start": 32.1,
      "end": 35.8,
      "chapterId": 2,
      "kind": "footage",
      "media": "episodes/reactive-mind/loai1_03_lonely_walk.mp4",
      "mediaDuration": 14.0,
      "mediaStart": 4.0,
      "title": "Vì sao có những người rất khó có một cuộc trò chuyện sâu sắc cùng họ?",
      "sourceCredit": "Cảnh phố đêm trầm lắng · Pixabay HD"
    },
    {
      "id": "beat-08",
      "start": 35.8,
      "end": 39.5,
      "chapterId": 2,
      "kind": "phone",
      "media": "episodes/reactive-mind/loai1_02_phone_dark.mp4",
      "mediaDuration": 14.0,
      "mediaStart": 4.0,
      "title": "Chỉ một góc nhìn khác biệt,\ncái tôi đã thấy bị xúc phạm.",
      "left": "Mình thử nhìn vấn đề này theo một hướng khác xem sao nhé?",
      "text": "Ý bạn là cách làm của tôi từ trước đến giờ hoàn toàn sai chứ gì..."
    },
    {
      "id": "beat-09",
      "start": 39.5,
      "end": 45.7,
      "chapterId": 2,
      "kind": "question",
      "media": "episodes/reactive-mind/loai1_06_rain_street.mp4",
      "mediaDuration": 14.0,
      "mediaStart": 5.0,
      "title": "ĐIỀU GÌ THỰC SỰ KÍCH HOẠT CƠN GIẬN?",
      "text": "Không phải vì lời bạn nói nặng nề,\nmà vì sự thật đó đe dọa hình ảnh hoàn hảo\nhọ vẫn luôn tin về chính mình."
    },
    {
      "id": "beat-10",
      "start": 45.7,
      "end": 54.0,
      "chapterId": 3,
      "kind": "comparison",
      "media": "episodes/reactive-mind/loai1_07_reading_book.mp4",
      "mediaDuration": 14.0,
      "mediaStart": 0,
      "title": "ĐỊNH NGHĨA LẠI SỰ TRƯỞNG THÀNH CẢM XÚC",
      "leftLabel": "Hiểu lầm thường gặp",
      "left": "“Trưởng thành là trở nên lạnh lùng, vô cảm và không còn biết buồn giận.”",
      "rightLabel": "Trưởng thành thực sự",
      "right": "“Vẫn có đủ mọi cảm xúc, nhưng không để cảm xúc ngồi vào ghế lái mọi hành động.”"
    },
    {
      "id": "beat-11",
      "start": 54.0,
      "end": 58.9,
      "chapterId": 3,
      "kind": "note",
      "media": "episodes/reactive-mind/loai1_07_reading_book.mp4",
      "mediaDuration": 14.0,
      "mediaStart": 5.0,
      "title": "GHI CHÚ NỘI TÂM · BA NHỊP CỦA SỰ TỈNH THỨC",
      "noteLabels": [
        "Nhịp 01 · Nhận diện",
        "Nhịp 02 · Dừng lại",
        "Nhịp 03 · Lựa chọn"
      ],
      "lines": [
        "Khi tức giận biết rõ mình đang giận; khi sợ hãi gọi tên được nỗi sợ.",
        "Tạo một khoảng nghỉ ngắn trước khi phản xạ vô thức kịp điều khiển.",
        "Quan sát chính mình và chủ động chọn cách đáp trả điềm tĩnh."
      ]
    },
